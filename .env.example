# --- Runtime mode ---
NODE_ENV=production

# --- Frontend / Vercel ---
NEXT_PUBLIC_API_URL=https://your-frontend-domain.vercel.app/api
INTERNAL_API_URL=http://api-gateway:80/api
IDENTITY_SERVICE_URL=https://identity.example.com
MOSQUE_SERVICE_URL=https://mosque.example.com
PRAYER_EVENT_SERVICE_URL=https://prayer.example.com
COMMUNITY_SERVICE_URL=https://community.example.com
GOVERNANCE_SERVICE_URL=https://governance.example.com
LIBRARY_SERVICE_URL=https://library.example.com
FINANCE_SERVICE_URL=https://finance.example.com

# --- Database & Cache ---
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://user:change-me@localhost:5432/mosque_db
REDIS_URL=redis://localhost:6379

# --- Security & Auth ---
JWT_SECRET=generate-a-secure-random-secret
JWT_REFRESH_SECRET=generate-another-secure-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
AUTH_COOKIE_NAME=mc_access_token
AUTH_COOKIE_MAX_AGE_MS=86400000

# --- Service Ports ---
IDENTITY_SERVICE_PORT=4001
MOSQUE_SERVICE_PORT=4002
PRAYER_EVENT_SERVICE_PORT=4003
COMMUNITY_SERVICE_PORT=4004
GOVERNANCE_SERVICE_PORT=4005
LIBRARY_SERVICE_PORT=4006
FINANCE_SERVICE_PORT=4007
NOTIFICATION_SERVICE_PORT=4008
GATEWAY_PORT=80
FRONTEND_PORT=3000
LOG_LEVEL=info

# --- Docker image publishing / deployment ---
IMAGE_PREFIX=ghcr.io
IMAGE_NAMESPACE=your-github-org
IMAGE_NAME_PREFIX=mosqueconnect-
IMAGE_TAG=latest

# --- GitHub Actions secrets required ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
